ACCTSET  DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,TIOAPFX=YES,       X
               STORAGE=AUTO,CTRL=(FREEKB,FRSET)
ACCTMAP  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,30),LENGTH=17,ATTRB=(ASKIP,BRT),                X
               INITIAL='ACCOUNT INQUIRY'
ACCTID   DFHMDF POS=(3,20),LENGTH=9,ATTRB=(UNPROT,IC)
NAME     DFHMDF POS=(5,20),LENGTH=20,ATTRB=PROT
MSG      DFHMDF POS=(22,1),LENGTH=40,ATTRB=PROT
         DFHMSD TYPE=FINAL
         END
