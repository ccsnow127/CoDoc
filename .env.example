# CoDoc configuration — copy to .env (never commit a key)
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1   # or any OpenAI-compatible endpoint
# CODOCS_MODEL=gpt-5.4            # any model your endpoint serves; aliases: gpt, gpt-mini, judge
# CODOCS_JUDGE_MODEL=gpt-5.5      # COBOL doc judge (deliberately not the generator's model)
# CODOCS_CODEGEN_MODEL=           # model that regenerates COBOL from its docs ("" = CODOCS_MODEL)
# CODOCS_GO=go                    # Go toolchain binary (e.g. /usr/local/go/bin/go)
# CODOCS_LANG=en                  # wiki language: en, ja, ko
