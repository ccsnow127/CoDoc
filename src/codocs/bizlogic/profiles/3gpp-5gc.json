  "wildcard_parties": [
    "AMF",
    "Peer AMF",
    "SMF",
    "UDM",
    "UDR",
    "AUSF",
    "PCF",
    "NRF",
    "NSSF",
    "SCP",
    "CHF",
    "5G-EIR",
    "GMLC / LCS client",
    "LMF",
    "NEF / AF",
    "CBC / warning gateway",
    "SMSF",
    "Other 5GC NFs"
  ],
  "actors": [
    {
      "name": "UDM",
      "kind": "nf",
      "pattern": "\\budm\\b|subscri(ber|ption) data",
      "aliases": [
        "UDM",
        "subscriber data",
        "subscription data"
      ]
    },
    {
      "name": "Peer AMF",
      "kind": "nf",
      "pattern": "\\b(source|target|old|new|peer|other|another|initial) amf\\b|inter-?amf|amf re-?allocation|^amf\\s*\\(\\s*n14\\b[^)]*\\)$",
      "primary": true,
      "aliases": [
        "source AMF",
        "target AMF",
        "old AMF",
        "peer AMF",
        "other AMF",
        "new AMF"
      ]
    },
    {
      "name": "AMF",
      "kind": "nf",
      "pattern": "^(the |serving )?amf(\\s*\\([^)]*\\))?$",
      "unless": "Peer AMF"
    },
    {
      "name": "UE",
      "kind": "nf",
      "pattern": "\\bue\\b|\\bsubscriber\\b(?! data)|user equipment",
      "label": "UE (subscriber device)",
      "device": true,
      "primary": true,
      "aliases": [
        "UE",
        "user equipment"
      ]
    },
    {
      "name": "NG-RAN (gNB)",
      "kind": "nf",
      "pattern": "gnb|\\bran\\b|ng-?ran|\\(r\\)an|access network|access node|nrppa|ran nodes?",
      "primary": true,
      "aliases": [
        "gNB",
        "NG-RAN",
        "RAN",
        "(R)AN"
      ],
      "case_sensitive_aliases": [
        "AN"
      ]
    },
    {
      "name": "NG-RAN (gNB)",
      "kind": "nf",
      "pattern": "\\bAN\\b",
      "case_sensitive": true
    },
    {
      "name": "SMF",
      "kind": "nf",
      "pattern": "\\b[ivh]?-?smf\\b"
    },
    {
      "name": "UPF",
      "kind": "nf",
      "pattern": "\\bupf\\b|user plane function"
    },
    {
      "name": "AUSF",
      "kind": "nf",
      "pattern": "\\bausf\\b|authentication server function"
    },
    {
      "name": "PCF",
      "kind": "nf",
      "pattern": "\\bpcf\\b|policy control function|policy-related"
    },
    {
      "name": "NRF",
      "kind": "nf",
      "pattern": "\\bnrf\\b"
    },
    {
      "name": "NSSF",
      "kind": "nf",
      "pattern": "\\bnssf\\b"
    },
    {
      "name": "UDR",
      "kind": "nf",
      "pattern": "\\budr\\b|unified data repository"
    },
    {
      "name": "SCP",
      "kind": "nf",
      "pattern": "\\bscp\\b"
    },
    {
      "name": "CHF",
      "kind": "nf",
      "pattern": "\\bchf\\b|charging"
    },
    {
      "name": "5G-EIR",
      "kind": "nf",
      "pattern": "\\b(5g-)?eir\\b"
    },
    {
      "name": "GMLC / LCS client",
      "kind": "nf",
      "pattern": "gmlc|lcs client|location (services|information) consumer"
    },
    {
      "name": "LMF",
      "kind": "nf",
      "pattern": "\\blmf\\b"
    },
    {
      "name": "MME (EPC)",
      "kind": "nf",
      "pattern": "\\bmme\\b|\\bepc\\b|legacy core|\\bn26\\b|mobility (node|peer)\\b|handover peer",
      "primary": true,
      "aliases": [
        "MME",
        "EPC",
        "EPS"
      ]
    },
    {
      "name": "CBC / warning gateway",
      "kind": "nf",
      "pattern": "\\bcbc[ef]?\\b|warning gateway|\\bpws\\b"
    },
    {
      "name": "NEF / AF",
      "kind": "nf",
      "pattern": "\\bnef\\b|application function|\\baf\\b|event (exposure )?consumer"
    },
    {
      "name": "SMSF",
      "kind": "nf",
      "pattern": "\\bsmsf\\b|sms function|sms-related"
    },
    {
      "name": "SMS-GMSC / IWMSC (SGd, Diameter)",
      "kind": "nf",
      "pattern": "diameter|\\bsgd\\b|sms-?gmsc|iwmsc|sms router|\\bsmsc\\b"
    },
    {
      "name": "OSS / BSS",
      "kind": "system",
      "pattern": "\\boss\\b|\\bbss\\b|northbound",
      "primary": true
    },
    {
      "name": "Other 5GC NFs",
      "kind": "generic",
      "pattern": "network functions?|\\bnfs?\\b|peer nf|5g core|5gc|partner services|remote http peer|other nf|callback (notification )?consumer|callback endpoint"
    }
  ],
